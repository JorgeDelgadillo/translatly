{
  "name": "translatly",
  "description": "Private, fully local translation extension for Chromium and Firefox",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm run setup:extension && wxt",
    "dev:firefox": "pnpm run setup:extension && wxt -b firefox",
    "build": "pnpm run setup:extension && wxt build",
    "build:firefox": "pnpm run setup:extension && wxt build -b firefox",
    "zip": "pnpm run setup:extension && wxt zip",
    "zip:firefox": "pnpm run setup:extension && wxt zip -b firefox",
    "check": "pnpm run setup:extension && svelte-check --tsconfig ./tsconfig.json",
    "check:release": "node scripts/check-release-metadata.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:smoke:model": "pnpm build && node scripts/smoke-real-model.mjs",
    "copy-ort-wasm": "node scripts/copy-ort-wasm.mjs",
    "setup:extension": "pnpm run copy-ort-wasm && wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.4",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "franc-min": "^6.2.0"
  }
}
